# =============================================================================
# nginx_routes.conf.template — the PROXY ROUTE TABLE shared by production and
# dev. Add a new proxied route HERE, once.
#
# WHY THIS FILE EXISTS
#   nginx.conf.template (production) and nginx_dev_common.conf.template (dev)
#   used to each carry their own copy of these ~25 locations, so every new
#   route was two edits and the copies could drift — which matters more than
#   usual here, because this table holds the admin auth gates (/sb/,
#   /radio/admin/), the /py/internal/ 404 and the /notes privacy denials. A
#   route that exists in one copy but not the other is a hole that only shows
#   up in the environment you were not testing.
#
# WHO INCLUDES IT
#   - nginx.conf.template, inside its :443 www server block.
#   - nginx_dev_common.conf.template, which is itself included by BOTH dev
#     server blocks — so in dev this file is pulled in twice. That is fine:
#     each inclusion lands in a different `server`, and everything below is
#     server-scoped.
#
# HOW IT IS RENDERED
#   nginx/entrypoint.sh runs the SAME envsubst allow-list over this file as
#   over the main templates and writes the result to
#   /etc/nginx/nginx_routes.conf, the path the `include` directives name. It
#   does so on every boot path, before the main config is chosen. A new
#   substituted variable used here must be added to ENVSUBST_VARS in the
#   entrypoint, or it reaches nginx unsubstituted.
#
# WHAT BELONGS HERE
#   The `set $upstream_*` variables and every reverse-proxied location that
#   behaves the same in production and dev, plus the admin-gate subrequest
#   they rely on. It must stay brace-balanced on its own (no enclosing
#   `server {`).
#
# WHAT DOES NOT, AND WHY
#   - add_header, in any location here. nginx's add_header inheritance is
#     all-or-nothing: a location with none of its own inherits the including
#     server block's set. Production's server block includes
#     security_headers.conf (HSTS etc.) and dev's deliberately does not, so
#     leaving these locations header-free is what lets the same text carry
#     security headers in production and none on localhost. Adding a single
#     add_header to a location below would silently drop production's
#     security headers from it.
#   - /uploads/ and /uploads/private/. They need add_header lines of their
#     own AND, in production only, security_headers.conf alongside them, so
#     for the reason above they cannot be shared. Each template has its copy;
#     keep the auth_request pair on /uploads/private/ identical in both.
#   - `location /`. Production serves the built SPA from disk, dev proxies to
#     the Vite dev server.
#   - $BACKEND_ENDPOINT/graphql. Production-only, with its own tighter
#     rate-limit zone; in dev GraphQL falls through to $BACKEND_ENDPOINT/
#     below. It lives in nginx.conf.template.
#   - Static asset caching, robots.txt, the ACME challenge and TLS: production
#     only, in nginx.conf.template.
#
# RATE LIMITS
#   The limit_req lines below name the zones `login`, `upload`, `api` and
#   `hotel_search`. A zone must be declared with limit_req_zone in the `http`
#   block of whichever config includes this file, or nginx refuses to load it
#   — so BOTH nginx.conf.template and nginx_dev.conf.template declare all
#   four (same rates; the reasoning is annotated in the production one). If
#   you use a new zone here, declare it in both.
#
# ORDER
#   Prefix locations are matched longest-first, so their order here is
#   cosmetic. REGEX locations (`~`, `~*`) are tried in file order and the
#   first match wins: keep the two /notes deny regexes ahead of the
#   /py/hotels one, and remember production's ACME regex location is declared
#   before this file is included.
# =============================================================================
        set $upstream_backend http://$BACKEND_HOST:$BACKEND_PORT;
        set $upstream_icecast http://$ICECAST_HOST:$ICECAST_PORT;
        set $upstream_gitea http://$GITEA_HOST:$GITEA_PORT;
        set $upstream_silverbullet http://$SILVERBULLET_HOST:$SILVERBULLET_PORT;
        set $upstream_silverbullet_public http://$SILVERBULLET_PUBLIC_HOST:$SILVERBULLET_PUBLIC_PORT;
        set $upstream_python http://$PYTHON_HOST:$PYTHON_PORT;
        # The job tracker's container name is fixed in docker-compose.yml, so
        # it needs no variable (and no ENVSUBST_VARS entry).
        set $upstream_jobs http://jobs:8080;

        # ---- Backend API -----------------------------------------------------
        # Two patterns repeat through every proxied location below:
        #
        # 1. THE PREFIX-STRIP REWRITE
        #      rewrite ^<PREFIX>/(.*)$ /$1 break;
        #    The public URL carries a prefix (/api, /radio, /gitea, /py) but the upstream service serves its routes from /. The
        #    rewrite strips the prefix and `break` stops rewrite processing so
        #    the request stays in this location and goes to proxy_pass with the
        #    rewritten URI. (This is why proxy_pass here has no trailing path —
        #    with a variable upstream, nginx would not do the strip for us.)
        #    The bare `location <PREFIX>` blocks that 301 to `<PREFIX>/` exist
        #    only so a user typing /gitea without the slash lands correctly.
        #
        # 2. THE FOUR FORWARDING HEADERS
        #      Host                  preserve the browser's hostname so the app
        #                            builds correct absolute URLs and cookies.
        #      X-Real-IP             the true client IP (the upstream otherwise
        #                            sees only nginx's container IP).
        #      X-Forwarded-For       appends the client to any existing chain.
        #      X-Forwarded-Proto     tells the app the ORIGINAL request was
        #                            https even though this hop is plain http.
        #                            Without it the backend would issue
        #                            non-Secure cookies and http:// redirects,
        #                            breaking auth behind TLS termination.
        #
        # Ordering matters: nginx picks the longest matching prefix location,
        # so the specific /ws, /auth/login and /messages/upload blocks (and
        # production's /graphql block in nginx.conf.template) win over the
        # catch-all <PREFIX>/ block regardless of file order.
        location $BACKEND_ENDPOINT {
            return 301 $BACKEND_ENDPOINT/;
        }

        # WebSocket endpoint (live chat / activity feed).
        # The three lines that make an upgrade work, and why each is needed:
        #   proxy_http_version 1.1   - HTTP/1.0 has no Upgrade mechanism at all.
        #   Upgrade $http_upgrade    - hop-by-hop headers are NOT forwarded by
        #   Connection "upgrade"       default, so they must be re-set by hand.
        # Note the Connection value is hardcoded rather than using the usual
        # $connection_upgrade map: this location only ever serves websockets, so
        # there is no plain-HTTP case to fall back to.
        # Deliberately NOT rate limited — a websocket is one long-lived request
        # and a limit_req here would drop reconnect storms, not abuse.
        location $BACKEND_ENDPOINT/ws {
            rewrite ^$BACKEND_ENDPOINT/(.*)$ /$1 break;
            proxy_pass $upstream_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location $BACKEND_ENDPOINT/auth/login {
            limit_req zone=login burst=3 nodelay;
            rewrite ^$BACKEND_ENDPOINT/(.*)$ /$1 break;
            proxy_pass $upstream_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location $BACKEND_ENDPOINT/messages/upload {
            limit_req zone=upload burst=3 nodelay;
            rewrite ^$BACKEND_ENDPOINT/(.*)$ /$1 break;
            proxy_pass $upstream_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Catch-all for the REST API. In production GraphQL does NOT land here:
        # nginx.conf.template declares a longer $BACKEND_ENDPOINT/graphql
        # location with a tighter zone. In dev it does.
        location $BACKEND_ENDPOINT/ {
            limit_req zone=api burst=20 nodelay;
            rewrite ^$BACKEND_ENDPOINT/(.*)$ /$1 break;
            proxy_pass $upstream_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /radio {
            return 301 /radio/;
        }

        # The icecast ADMIN UI (/radio/admin/*) is a full station-control
        # surface — kick sources, change metadata — protected only by the
        # icecast admin password, and it was reachable from the public
        # internet through this proxy. Put it behind the same admin
        # `auth_request` as /sb/ so an admin session cookie is
        # required before the request ever reaches icecast. Longest-prefix
        # matching means this wins over /radio/ below; listener traffic
        # (/radio/$ICECAST_MOUNT, /radio/status.xsl) is untouched.
        location /radio/admin/ {
            auth_request /internal/auth/admin-validate;
            error_page 401 403 = @auth_denied;
            rewrite ^/radio/(.*)$ /$1 break;
            proxy_pass $upstream_icecast;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /radio/ {
            rewrite ^/radio/(.*)$ /$1 break;
            proxy_pass $upstream_icecast;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /gitea {
            return 301 /gitea/;
        }

        location /gitea/ {
            rewrite ^/gitea/(.*)$ /$1 break;
            proxy_pass $upstream_gitea;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /notes {
            return 301 /notes/;
        }

        # PUBLIC notes viewer: a second, read-only SilverBullet over the same
        # vault the /sb/ editor edits. No auth_request — this is the public
        # site. See the silverbullet-public service in docker-compose.yml.
        #
        # THE DENY BLOCKS BELOW ARE THE PRIVACY BOUNDARY, not decoration.
        # SB_SPACE_IGNORE only hides paths from the file LIST. Everything else
        # happily serves them (all verified against 2.11.0 with curl):
        #   /notes/.fs/private/x.md    raw file, straight off disk
        #   /notes/private/x           the page URL: the server pre-renders the
        #                              note's content into the HTML shell
        #   /notes/.fs/.git/...        the vault's whole git repo, i.e. every
        #                              version of every private note ever
        # and gitignore semantics mean `private/` in SB_SPACE_IGNORE hides a
        # private/ folder at ANY depth from the list, so the block must too.
        #
        # 1. private/ or templates/ as any path segment, page URL or /.fs/.
        #    ~* so Private/ is caught; (/|$) so the folder itself matches.
        # 2. Any dot-segment below the first: .git, .obsidian, .env, ... The
        #    first segment is exempt because that is where SilverBullet's own
        #    endpoints live (/.fs, /.config, /.client, /.events ...). Nothing
        #    the client legitimately loads has a dot-segment deeper than that.
        # nginx matches against the normalised URI (percent-decoded, `..`
        # resolved, slashes merged), so %2F, // or ../ tricks cannot slip past.
        # Keep the folder list in step with SB_SPACE_IGNORE on
        # silverbullet-public. 404 rather than 403 so the response does not
        # confirm a private path exists.
        location ~* ^/notes/(.*/)?(private|templates)(/|$) {
            return 404;
        }

        location ~ ^/notes/.+/\. {
            return 404;
        }

        # Revisions are read from the vault's own .git, i.e. the full history
        # of every file INCLUDING private/ and anything ever deleted.
        # SB_REVISIONS=disabled already turns this off upstream; this is the
        # second lock in case that env var is ever dropped. ^~ so no regex
        # location can take precedence.
        location ^~ /notes/.revisions {
            return 404;
        }

        # Same as /sb/: deliberately NO prefix-strip rewrite. The app is told
        # its base path via SB_URL_PREFIX=/notes and builds its service worker
        # scope and asset URLs from it; strip the prefix and it loads blank.
        # Upgrade/Connection are for its live-update event stream.
        location /notes/ {
            proxy_pass $upstream_silverbullet_public;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /sb {
            return 301 /sb/;
        }

        # SilverBullet: the admin-only EDITOR for the vault /notes/ publishes.
        # Deliberately NO prefix-strip rewrite, unlike every other proxied app
        # here. SilverBullet is a PWA told its own base path via SB_URL_PREFIX=/sb,
        # and its service worker scope and asset URLs are built from that. Strip
        # the prefix and the app loads a blank page with no error in the log.
        # Upgrade/Connection are for its sync websocket.
        location /sb/ {
            auth_request /internal/auth/admin-validate;
            error_page 401 403 = @auth_denied;
            proxy_pass $upstream_silverbullet;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /py {
            return 301 /py/;
        }

        # /py/hotels/search[/stream] and /py/hotels/scan/stream: long-running NDJSON streams
        location ~ ^/py/hotels/(search|scan) {
            # Public, up-to-a-minute upstream call with a single search slot: keep it to a few per minute per IP
            limit_req zone=hotel_search burst=2 nodelay;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            # The stream variant sends NDJSON progress lines; pass them through as they arrive
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            rewrite ^/py/(.*)$ /$1 break;
            proxy_pass $upstream_python;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # /py/internal/: routes the Go backend calls directly over app-network
        # (the rowing photo reader and the job posting reader, which spend a
        # paid Claude call and have no auth of their own). Never proxied. ^~ so no regex location can claim
        # the path first. The Python side also refuses anything carrying the
        # X-Real-IP / X-Forwarded-For headers set below, as a second layer.
        location ^~ /py/internal/ {
            return 404;
        }

        location /py/ {
            limit_req zone=api burst=20 nodelay;
            # Hotel search blocks for up to a few minutes while it calls Travelodge and TfL
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            rewrite ^/py/(.*)$ /$1 break;
            proxy_pass $upstream_python;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ---- Job tracker (/jobs/) ----
        # Its own container (the adamf/job-tracker repo), which serves its SPA
        # and its API from the same prefix. The prefix is NOT stripped: the
        # app is built to live at /jobs/. There is no auth_request here: the
        # SPA's files are public, and every API route that is not checks the
        # session itself, by asking the backend's validate-admin with the
        # visitor's cookies. ^~ so no regex location can claim a /jobs/ path.
        location = /jobs {
            return 301 /jobs/;
        }

        location ^~ /jobs/ {
            limit_req zone=api burst=20 nodelay;
            # "Sync now" on the Settings page runs a whole email sync before
            # answering.
            proxy_read_timeout 300s;
            proxy_pass $upstream_jobs;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Where the tracker used to be. The SPA routes were client-side, so
        # these only catch bookmarks and typed URLs. The userscript's old
        # @updateURL lands on the third, which is how installed copies find
        # version 2.0.0 and its new API base.
        location = /cv/jobs {
            return 301 /jobs/;
        }
        location = /cv/leads {
            return 301 /jobs/leads;
        }
        location = /job-capture.user.js {
            return 301 /jobs/job-capture.user.js;
        }

        # ---- Admin gate (/sb/, /radio/admin/, /uploads/private/) ----
        # (/uploads/private/ is declared in the including template, not here;
        # it points at the two locations below by name.)
        # `auth_request` makes nginx fire a subrequest here before serving the
        # real one; a 2xx lets it through, 401/403 triggers error_page ->
        # @auth_denied -> redirect to the SPA login. This puts the Go backend's
        # session cookie in front of services that have no idea it exists.
        #   internal;                 - unreachable from outside, subrequest only.
        #   proxy_pass_request_body off + Content-Length ""
        #                             - the subrequest must not replay the
        #                               original body (it could be a 50MB
        #                               upload); clearing Content-Length stops
        #                               the backend waiting for a body that is
        #                               not coming.
        #   Cookie $http_cookie       - the whole point: forward the session
        #                               cookie so the backend can validate it.
        location = /internal/auth/admin-validate {
            internal;
            rewrite ^ /auth/validate-admin break;
            proxy_pass $upstream_backend;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
        }

        location @auth_denied {
            return 302 /admin/login?redirect=$request_uri;
        }
