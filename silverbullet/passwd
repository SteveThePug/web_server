# Minimal /etc/passwd for the silverbullet-git container.
#
# The container runs as uid 1000 (matching the vault's owner on the host) so its
# commits don't leave root-owned objects in .git. But alpine/git has no passwd
# entry for that uid, and ssh refuses to start for a uid it cannot resolve --
# it fails with "No user exists for uid 1000" before it ever tries the key, so
# every push fails. Mounting this file over /etc/passwd gives ssh something to
# resolve. SilverBullet's own entrypoint solves the same problem by creating the
# user at boot; this container has no entrypoint of its own to do that in.
root:x:0:0:root:/root:/bin/sh
sbgit:x:1000:1000:sbgit:/tmp:/bin/sh
